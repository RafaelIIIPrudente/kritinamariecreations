# Copy this file to `.env` and fill in the values.
# See README.md → "Connect Supabase" for where each value comes from.

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL of the site. In production set this to your real domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: shown in metadata. Usually your app version or a git sha.
NEXT_PUBLIC_SITE_VERSION=

# ── Logging ──────────────────────────────────────────────────────────────────
# One of: NONE | ERROR | WARN | DEBUG | ALL
NEXT_PUBLIC_LOG_LEVEL=ALL

# ── Auth ─────────────────────────────────────────────────────────────────────
# Only SUPABASE is wired in this template.
NEXT_PUBLIC_AUTH_STRATEGY=SUPABASE

# ── Supabase ─────────────────────────────────────────────────────────────────
# Hosted: Supabase project → Settings → Data API (URL) and API Keys (anon).
# Local:  run `supabase start` and copy the printed API URL and anon key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Database (Drizzle) ───────────────────────────────────────────────────────
# SERVER-ONLY secret — never prefix with NEXT_PUBLIC and never reference it from
# client code (it is validated apart in src/env.server.ts).
# Use the Supabase TRANSACTION POOLER connection string (port 6543): Supabase
# project → Settings → Database → Connection string → Transaction pooler.
# Leave this UNSET to run on the in-memory mock (the default) — the app builds
# and runs with no database configured.
# DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres

# ── PostHog analytics (optional) ─────────────────────────────────────────────
# The whole integration is INERT unless NEXT_PUBLIC_POSTHOG_KEY is set (no init,
# no network). The project token is PUBLISHABLE (not a secret), so NEXT_PUBLIC_*
# is correct — do NOT put it in a server-only file. Client ingestion is proxied
# same-origin via the `/relay` reverse proxy (next.config.ts rewrites) to keep
# the strict CSP unchanged and dodge ad-blockers.
# NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_token
# Real ingestion host for the SERVER SDK (US default; EU variant shown):
#   US: https://us.i.posthog.com   ·   EU: https://eu.i.posthog.com
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Consent (privacy-first / GDPR): "true" (default) captures NOTHING until the
# user opts in — wire optIn() from src/lib/analytics/consent.ts into a consent
# banner. "false" captures immediately on load.
# NEXT_PUBLIC_POSTHOG_REQUIRE_CONSENT=true
